{
  "name": "mrl-quotation",
  "productName": "MRL GROUP OF COMPANIES",
  "version": "1.0.0",
  "description": "Quotation, invoice, expense, income, employee & payroll management desktop app",
  "main": "electron/main.js",
  "author": "MRL Fabrications",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:server": "cross-env NODE_ENV=development node server/index.js",
    "dev:web": "concurrently -k \"npm:dev:vite\" \"npm:dev:server\"",
    "build:vite": "vite build",
    "build:electron": "npm run build:vite && electron-builder",
    "build:win": "npm run build:vite && electron-builder --win",
    "build:server": "npm run build:vite",
    "start": "cross-env NODE_ENV=development electron .",
    "start:server": "cross-env NODE_ENV=production node server/index.js",
    "web": "npm run build:vite && npm run start:server",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "better-sqlite3-session-store": "^0.1.0",
    "call-bind-apply-helpers": "^1.0.1",
    "compression": "^1.8.1",
    "date-fns": "^3.6.0",
    "dunder-proto": "^1.0.1",
    "electron-store": "^8.2.0",
    "es-define-property": "^1.0.1",
    "es-errors": "^1.3.0",
    "es-object-atoms": "^1.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "get-intrinsic": "^1.3.0",
    "get-proto": "^1.0.1",
    "gopd": "^1.2.0",
    "has-symbols": "^1.1.0",
    "helmet": "^8.3.0",
    "hasown": "^2.0.2",
    "math-intrinsics": "^1.1.0",
    "multer": "^2.3.0",
    "pdfjs-dist": "^5.6.205",
    "pdfmake": "^0.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "vite": "^5.4.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.mrl.groupofcompanies",
    "productName": "MRL GROUP OF COMPANIES",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MRL-Group-of-Companies-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MRL GROUP OF COMPANIES"
    }
  }
}
