# MRL GROUP OF COMPANIES — environment variables
#
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# TURSO_URL / TURSO_AUTH_TOKEN → when set, the app connects to Turso in
# embedded-replica mode: a local SQLite file kept in sync with the remote
# Turso database every 30 seconds. Writes go through Turso, so the data
# survives every restart, redeploy, and platform sleep.
#
# Leave both unset for pure local SQLite (dev-only, no cloud sync).

TURSO_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-token-here

# Web-server settings (only used by `npm run start:server`)
PORT=8080
NODE_ENV=production
DATA_DIR=./data
SESSION_SECRET=change-me-in-production
